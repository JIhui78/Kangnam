    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Force logout on page load for a fresh start
            localStorage.removeItem('isLoggedIn');
            localStorage.removeItem('loggedInUser');
            localStorage.removeItem('userProfile'); // Also clear profile data

            const navLinks = document.querySelectorAll('nav ul li a');
            const sections = document.querySelectorAll('.main-content');

            // --- Login/Registration Management --- START
            const loginNavLink = document.getElementById('login-nav-link');

            const loginFormContainer = document.getElementById('login-form-container');
            const loginForm = document.getElementById('login-form');
            const loginStudentIdInput = document.getElementById('login_student_id');
            const loginPasswordInput = document.getElementById('login_password');

            const registerFormContainer = document.getElementById('register-form-container');
            const registerForm = document.getElementById('register-form');
            const registerStudentIdInput = document.getElementById('register_student_id');
            const registerPasswordInput = document.getElementById('register_password');
            const registerConfirmPasswordInput = document.getElementById('register_confirm_password');

            const showRegisterFormButton = document.getElementById('show-register-form-button');
            const showLoginFormButton = document.getElementById('show-login-form-button');

            const logoutMessageContainer = document.getElementById('logout-message-container');
            const loggedInUserDisplay = document.getElementById('logged-in-user-display');
            const logoutButton = document.getElementById('logout_button');
            const userProfileSection = document.getElementById('user-profile-section');

            // New elements for conditional display
            const homeAnnouncementsSnippet = document.getElementById('home-announcements-snippet');
            const homeSchedulesSnippet = document.getElementById('home-schedules-snippet');
            const scheduleInputForm = document.getElementById('schedule-input-form');
            const scheduleDisplayArea = document.getElementById('schedule-display-area');

            // Store registered users (dummy for client-side)
            let registeredUsers = JSON.parse(localStorage.getItem('registeredUsers')) || {};
            // Add the 'test' user with password '1234' for administrator testing
            if (!registeredUsers['test']) {
                registeredUsers['test'] = { password: '1234' };
                localStorage.setItem('registeredUsers', JSON.stringify(registeredUsers));
            }

            function showLoginForm() {
                loginFormContainer.classList.remove('hidden');
                registerFormContainer.classList.add('hidden');
            }

            function showRegisterForm() {
                loginFormContainer.classList.add('hidden');
                registerFormContainer.classList.remove('hidden');
            }

            showRegisterFormButton.addEventListener('click', showRegisterForm);
            showLoginFormButton.addEventListener('click', showLoginForm);

            function checkLoginStatus() {
                const isLoggedIn = localStorage.getItem('isLoggedIn') === 'true';
                const loggedInUser = localStorage.getItem('loggedInUser');

                if (isLoggedIn) {
                    loginNavLink.textContent = '로그아웃';
                    loginFormContainer.classList.add('hidden');
                    registerFormContainer.classList.add('hidden'); // Hide registration form too
                    logoutMessageContainer.classList.remove('hidden');
                    loggedInUserDisplay.textContent = loggedInUser;
                    userProfileSection.classList.remove('hidden'); // Show profile section when logged in
                    homeAnnouncementsSnippet.classList.remove('hidden');
                    homeSchedulesSnippet.classList.remove('hidden');
                    scheduleInputForm.classList.remove('hidden');
                    scheduleDisplayArea.classList.remove('hidden');
                    renderProfile(); // Ensure profile data is rendered
                    renderLatestSchedules(); // Update latest schedules on home
                    renderSchedules(); // Update full schedule list
                } else {
                    loginNavLink.textContent = '로그인/회원가입';
                    logoutMessageContainer.classList.add('hidden');
                    loggedInUserDisplay.textContent = '';
                    userProfileSection.classList.add('hidden'); // Hide profile section when logged out
                    homeAnnouncementsSnippet.classList.add('hidden');
                    homeSchedulesSnippet.classList.add('hidden');
                    scheduleInputForm.classList.add('hidden');
                    scheduleDisplayArea.classList.add('hidden');
                    showLoginForm(); // Default to showing the login form
                }
            }

            loginForm.addEventListener('submit', function(event) {
                event.preventDefault();
                const studentId = loginStudentIdInput.value;
                const password = loginPasswordInput.value;

                if (registeredUsers[studentId] && registeredUsers[studentId].password === password) {
                    localStorage.setItem('isLoggedIn', 'true');
                    localStorage.setItem('loggedInUser', studentId);
                    alert('로그인 성공!');
                    checkLoginStatus();
                    showSection('#home'); // Go to home page after login
                } else {
                    alert('잘못된 학번 또는 비밀번호입니다.');
                }
            });

            registerForm.addEventListener('submit', function(event) {
                event.preventDefault();
                const studentId = registerStudentIdInput.value;
                const password = registerPasswordInput.value;
                const confirmPassword = registerConfirmPasswordInput.value;

                if (!studentId || !password || !confirmPassword) {
                    alert('모든 필드를 입력해주세요.');
                    return;
                }

                if (password !== confirmPassword) {
                    alert('비밀번호가 일치하지 않습니다.');
                    return;
                }

                if (registeredUsers[studentId]) {
                    alert('이미 존재하는 학번입니다.');
                    return;
                }

                registeredUsers[studentId] = { password: password };
                localStorage.setItem('registeredUsers', JSON.stringify(registeredUsers));
                alert('회원가입 성공! 이제 로그인할 수 있습니다.');
                registerStudentIdInput.value = '';
                registerPasswordInput.value = '';
                registerConfirmPasswordInput.value = '';
                showLoginForm(); // Show login form after successful registration
            });

            logoutButton.addEventListener('click', function() {
                localStorage.setItem('isLoggedIn', 'false');
                localStorage.removeItem('loggedInUser');
                // Clear profile data on logout if desired
                localStorage.removeItem('userProfile');
                userProfile = {
                    name: '미정',
                    studentId: '미정',
                    department: '미정',
                    photoUrl: 'https://via.placeholder.com/100'
                };
                alert('로그아웃되었습니다.');
                checkLoginStatus();
                showSection('#login'); // Go to login page after logout
            });

            // Call checkLoginStatus on initial load
            checkLoginStatus();
            // --- Login/Registration Management --- END


            // --- New Schedule Management --- START
            const scheduleForm = document.getElementById('schedule-input-form');
            const scheduleDateInput = document.getElementById('schedule-date');
            const scheduleContentInput = document.getElementById('schedule-content');
            const scheduleItemsList = document.getElementById('schedule-items');
            const latestSchedulesList = document.getElementById('latest-schedules');

            let schedules = JSON.parse(localStorage.getItem('userSchedules')) || [];

            function saveSchedules() {
                localStorage.setItem('userSchedules', JSON.stringify(schedules));
            }

            function renderSchedules() {
                scheduleItemsList.innerHTML = ''; // Clear current list
                schedules.sort((a, b) => new Date(a.date) - new Date(b.date)); // Sort by date

                if (schedules.length === 0) {
                    scheduleItemsList.innerHTML = '<li style="font-size: 0.9em; color: #777;">등록된 일정이 없습니다.</li>';
                } else {
                    schedules.forEach(schedule => {
                        const listItem = document.createElement('li');
                        listItem.style.marginBottom = '8px';
                        listItem.style.padding = '8px';
                        listItem.style.backgroundColor = '#ffffff';
                        listItem.style.border = '1px solid #e0e0e0';
                        listItem.style.borderRadius = '4px';

                        const deleteButton = document.createElement('button');
                        deleteButton.textContent = '삭제';
                        deleteButton.style.marginLeft = '10px';
                        deleteButton.style.backgroundColor = '#ef5350';
                        deleteButton.style.color = 'white';
                        deleteButton.style.border = 'none';
                        deleteButton.style.borderRadius = '3px';
                        deleteButton.style.cursor = 'pointer';
                        deleteButton.style.fontSize = '0.8em';
                        deleteButton.style.padding = '5px 10px';
                        deleteButton.onclick = () => deleteSchedule(schedule.id);

                        listItem.innerHTML = `<strong>${schedule.date}</strong>: ${schedule.content}`;
                        listItem.appendChild(deleteButton);
                        scheduleItemsList.appendChild(listItem);
                    });
                }
            }

            function renderLatestSchedules() {
                latestSchedulesList.innerHTML = '';
                const allSchedules = JSON.parse(localStorage.getItem('userSchedules')) || [];

                // Sort by date to get the 5 most recent schedules
                const sortedSchedules = allSchedules.sort((a, b) => new Date(b.date) - new Date(a.date)); // Sort descending by date
                const top5Schedules = sortedSchedules.slice(0, 5);

                if (top5Schedules.length === 0) {
                    latestSchedulesList.innerHTML = '<li style="font-size: 0.9em; color: #777;">아직 등록된 일정이 없습니다.</li>';
                } else {
                    top5Schedules.forEach(schedule => {
                        const listItem = document.createElement('li');
                        listItem.style.marginBottom = '5px';
                        listItem.style.fontSize = '0.95em';
                        listItem.innerHTML = `<strong>${schedule.date}</strong>: ${schedule.content}`;
                        latestSchedulesList.appendChild(listItem);
                    });
                }
            }

            function addSchedule(event) {
                event.preventDefault();
                const date = scheduleDateInput.value;
                const content = scheduleContentInput.value;

                if (date && content) {
                    const newSchedule = {
                        id: Date.now(), // Unique ID based on timestamp
                        date: date,
                        content: content
                    };
                    schedules.push(newSchedule);
                    saveSchedules();
                    renderSchedules();
                    renderLatestSchedules(); // Update latest schedules on home
                    scheduleDateInput.value = '';
                    scheduleContentInput.value = '';
                } else {
                    alert('날짜와 내용을 모두 입력해주세요.');
                }
            }

            function deleteSchedule(idToDelete) {
                schedules = schedules.filter(schedule => schedule.id !== idToDelete);
                saveSchedules();
                renderSchedules();
                renderLatestSchedules(); // Update latest schedules on home
            }

            scheduleForm.addEventListener('submit', addSchedule);

            // Initial render of schedules on page load (now handled by checkLoginStatus)
            // renderSchedules();
            // renderLatestSchedules();
            // --- New Schedule Management --- END

            // --- Department Selection Management --- START
            const departmentSelect = document.getElementById('department-select');
            const departmentSelectionForm = document.getElementById('department-selection-form');
            const selectedDepartmentInfo = document.getElementById('selected-department-info');
            const departmentAnnouncementLink = document.getElementById('department-announcement-link');

            const departmentUrls = {
                'gyoyuk': { name: '교육학과', url: 'https://educ.kangnam.ac.kr/menu/8e4d118b43e9fb0f1d3d8ff4a35911c4.do?encMenuSeq=8e4d118b43e9fb0f1d3d8ff4a35911c4' },
                'gukje': { name: '국제지역학과', url: 'https://kcc.kangnam.ac.kr/menu/29b8da331f6b973f09bfef239630d1b7.doe' },
                'gidokgyo': { name: '기독교커뮤니케이션학과', url: 'https://kcc.kangnam.ac.kr/menu/29b8da331f6b973f09bfef239630d1b7.do' },
                'design': { name: '디자인학과', url: 'https://design.kangnam.ac.kr/menu/a79de9b3128bc2343d9411dfedb753c7.do?encMenuSeq=e172d2fa3c62378dcdc4eb464f4e4e44' },
                'munhwa': { name: '문화콘텐츠학과', url: 'https://kcc.kangnam.ac.kr/menu/29b8da331f6b973f09bfef239630d1b7.do' },
                'beophaengjeong': { name: '법행정세무학부', url: 'https://pet.kangnam.ac.kr/menu/04cb25b9b9430b879fd82a9ef90206aa.do' },
                'budongsan': { name: '부동산건설학부', url: 'https://knureal.kangnam.ac.kr/menu/26c80ce9728657a14fe638d4c566ead8.do' },
                'sahoe': { name: '사회복지학부', url: 'https://knusw.kangnam.ac.kr/menu/22dd7f703ec676ffdecdd6b4e4fe1b1b.do' },
                'sanggyeong': { name: '상경학부', url: 'https://globalbiz.kangnam.ac.kr/menu/6b108ed6447a9b934100e9a1ddc0c070.do' },
                'senior': { name: '시니어비즈니스학과', url: 'https://senior-industry.kangnam.ac.kr/menu/f61730fb09006de23bee07331bfda13e.do' },
                'yua': { name: '유아교육과', url: 'https://knece.kangnam.ac.kr/menu/1e179ef9d06b26f3ae133a18a5ee1ba7.do?encMenuSeq=1e569e49501c257ffcaa413ead4891a4' },
                'eumak': { name: '음악학과', url: 'https://musicdpt.kangnam.ac.kr/menu/ac37fa802cc891d4909f48061ae97ecc.do?encMenuSeq=970a322d11d6d9494f57a2e392aba54d' },
                'aifusion': { name: '인공지능융합공학부', url: 'https://ace.kangnam.ac.kr/menu/f3a3bfbbc5715e4180657f71177d8bcf.do?encMenuSeq=184c634d3db29e58344d70cd8f2c4d38' },
                'jayu': { name: '자유전공학부', url: 'https://dls.kangnam.ac.kr/menu/e789c348fbc8bb492728f600b8f41a44.do' },
                'jeonja': { name: '전자반도체공학부', url: 'https://esc.kangnam.ac.kr/menu/f25ac6a8a2a27a5a10fee744b5084a6e.do' },
                'jungguk': { name: '중국콘텐츠비즈니스학과', url: 'https://kcc.kangnam.ac.kr/menu/29b8da331f6b973f09bfef239630d1b7.do' },
                'jungdeung': { name: '중등특수교육과', url: 'https://sped.kangnam.ac.kr/menu/f1b0fb76ba66f0a7319fc278bed29175.do?encMenuSeq=7215d10f46aab343ffaf4be8d77c6d57' },
                'cheyuk': { name: '체육학과', url: 'https://ksps.kangnam.ac.kr/' },
                'chodeung': { name: '초등특수교육과', url: 'https://sped.kangnam.ac.kr/menu/f1b0fb76ba66f0a7319fc278bed29175.do?encMenuSeq=7215d10f46aab343ffaf4be8d77c6d57' },
                'computer': { name: '컴퓨터공학부', url: 'https://sae.kangnam.ac.kr/menu/e408e5e7c9f27b8c0d5eeb9e68528b48.do' },
                'hangugeo': { name: '한국어문학과', url: 'https://kcc.kangnam.ac.kr/menu/29b8da331f6b973f09bfef239630d1b7.do' }
            };

            function loadSelectedDepartment() {
                const savedDepartment = localStorage.getItem('selectedDepartment');
                if (savedDepartment && departmentUrls[savedDepartment]) {
                    departmentSelect.value = savedDepartment;
                    displayDepartmentLink(savedDepartment);
                }
            }

            function displayDepartmentLink(departmentKey) {
                const dept = departmentUrls[departmentKey];
                if (dept) {
                    selectedDepartmentInfo.textContent = `${dept.name} (${dept.url})`;
                    departmentAnnouncementLink.href = dept.url;
                    departmentAnnouncementLink.textContent = `${dept.name} 공지사항 바로가기`;
                    departmentAnnouncementLink.style.display = 'inline-block';
                } else {
                    selectedDepartmentInfo.textContent = '선택된 학과가 없습니다.';
                    departmentAnnouncementLink.style.display = 'none';
                }
            }

            departmentSelectionForm.addEventListener('submit', function(event) {
                event.preventDefault();
                const selectedValue = departmentSelect.value;
                if (selectedValue) {
                    localStorage.setItem('selectedDepartment', selectedValue);
                    displayDepartmentLink(selectedValue);
                    alert(`${departmentUrls[selectedValue].name}으로 학과가 저장되었습니다.`);
                } else {
                    alert('학과를 선택해주세요.');
                }
            });

            // Initial load of selected department
            loadSelectedDepartment();
            // --- Department Selection Management --- END

            // --- User Profile Management --- START
            const profileNameDisplay = document.getElementById('profile-name-display');
            const profileStudentIdDisplay = document.getElementById('profile-student-id-display');
            const profileDepartmentDisplay = document.getElementById('profile-department-display');
            const profilePicture = document.getElementById('profile-picture');
            const editProfileButton = document.getElementById('edit-profile-button');
            const profileEditForm = document.getElementById('profile-edit-form');
            const editNameInput = document.getElementById('edit-name');
            const editStudentIdInput = document.getElementById('edit-student-id');
            const editDepartmentInput = document.getElementById('edit-department');
            const editPhotoUploadInput = document.getElementById('edit-photo-upload'); // Changed ID
            const saveProfileButton = document.getElementById('save-profile-button');
            const cancelProfileButton = document.getElementById('cancel-profile-button');

            let userProfile = JSON.parse(localStorage.getItem('userProfile')) || {
                name: '미정',
                studentId: '미정',
                department: '미정',
                photoUrl: 'https://via.placeholder.com/100' // Default placeholder image
            };

            function renderProfile() {
                // Only render if logged in, or if it's the default placeholder state
                const isLoggedIn = localStorage.getItem('isLoggedIn') === 'true';
                if (!isLoggedIn) {
                    // If not logged in, revert to default placeholder values in display
                    profileNameDisplay.textContent = '미정';
                    profileStudentIdDisplay.textContent = '미정';
                    profileDepartmentDisplay.textContent = '미정';
                    profilePicture.src = 'https://via.placeholder.com/100';
                    editNameInput.value = '';
                    editStudentIdInput.value = '';
                    editDepartmentInput.value = '';
                    editPhotoUploadInput.value = ''; // Clear file input
                    return;
                }

                profileNameDisplay.textContent = userProfile.name;
                profileStudentIdDisplay.textContent = userProfile.studentId;
                profileDepartmentDisplay.textContent = userProfile.department;
                profilePicture.src = userProfile.photoUrl;

                // Update edit form fields as well
                editNameInput.value = userProfile.name === '미정' ? '' : userProfile.name;
                editStudentIdInput.value = userProfile.studentId === '미정' ? '' : userProfile.studentId;
                editDepartmentInput.value = userProfile.department === '미정' ? '' : userProfile.department;
                editPhotoUploadInput.value = ''; // Clear file input, user has to re-select if they want to change
            }

            function saveProfile() {
                localStorage.setItem('userProfile', JSON.stringify(userProfile));
                renderProfile();
            }

            editProfileButton.addEventListener('click', function() {
                profileEditForm.style.display = 'block';
                editProfileButton.style.display = 'none';
            });

            saveProfileButton.addEventListener('click', function() {
                userProfile.name = editNameInput.value || '미정';
                userProfile.studentId = editStudentIdInput.value || '미정';
                userProfile.department = editDepartmentInput.value || '미정';

                if (editPhotoUploadInput.files.length > 0) {
                    const file = editPhotoUploadInput.files[0];
                    const reader = new FileReader();

                    reader.onload = function(e) {
                        userProfile.photoUrl = e.target.result;
                        saveProfile(); // Save and render after file is read
                        profileEditForm.style.display = 'none';
                        editProfileButton.style.display = 'inline-block';
                    };
                    reader.readAsDataURL(file);
                } else {
                    // If no new file is selected, keep existing photoUrl (or default)
                    saveProfile();
                    profileEditForm.style.display = 'none';
                    editProfileButton.style.display = 'inline-block';
                }
            });

            cancelProfileButton.addEventListener('click', function() {
                profileEditForm.style.display = 'none';
                editProfileButton.style.display = 'inline-block';
                renderProfile(); // Revert form fields to current saved profile
            });

            // Initial render of profile on page load (now handled by checkLoginStatus to ensure visibility based on login)
            // renderProfile();
            // --- User Profile Management --- END

            // 모든 섹션을 숨기고 특정 섹션만 보이게 하는 함수
            function showSection(targetId) {
                sections.forEach(section => {
                    section.classList.remove('active');
                });
                const targetSection = document.querySelector(targetId);
                if (targetSection) {
                    targetSection.classList.add('active');
                }
            }

            // 내비게이션 링크 클릭 이벤트 처리
            navLinks.forEach(link => {
                link.addEventListener('click', function(event) {
                    // Prevent default anchor behavior for all links first
                    event.preventDefault();

                    const targetId = this.getAttribute('href');
                    const isLoggedIn = localStorage.getItem('isLoggedIn') === 'true'; // Get current login status

                    // Special handling for the login/logout link
                    if (this.id === 'login-nav-link') {
                        if (isLoggedIn) {
                            logoutButton.click();
                        } else {
                            // If currently logged out, clicking this link shows the login section
                            showSection('#login');
                            showLoginForm();
                        }
                        return;
                    }

                    // Special handling for Homepage Linkage
                    if (targetId === '#homepage-linkage') {
                        window.open('https://www.kangnam.ac.kr/', '_blank');
                        return; // Stop further processing
                    }

                    // For all other navigation links:
                    if (!isLoggedIn) {
                        alert('로그인 후 이용 가능한 서비스입니다.');
                        return;
                    }

                    showSection(targetId);
                });
            });

            // 공지사항 아이템 클릭 이벤트 처리 - REMOVED (No longer applicable after removing school-announcements section)
            // announcementItems.forEach(item => {
            //     item.addEventListener('click', function() {
            //         const detail = this.querySelector('.announcement-detail');
            //         if (detail) {
            //             detail.style.display = detail.style.display === 'block' ? 'none' : 'block';
            //         }
            //     });
            // });

            // 페이지 로드 시 초기 활성화 섹션 설정
            if (localStorage.getItem('isLoggedIn') === 'true') {
                showSection('#home');
            } else {
                showSection('#login');
                showLoginForm(); // Ensure login form is visible initially
            }
        });
    </script>
</body>
</html>
"""
