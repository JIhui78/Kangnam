                <a href="https://web.kangnam.ac.kr/menu/f19069e6134f8f8aa7f689a4a675e66f.do?searchMenuSeq=0" class="button" target="_blank" style="padding: 5px 10px; font-size: 0.9em; margin-top: 10px;">전체 공지사항 보기</a>
            </div>

            <!-- New: Latest Schedules snippet on Home page -->
            <div id="home-schedules-snippet" style="margin-top: 30px; padding: 15px; border: 1px solid #e0e0e0; border-radius: 5px; background-color: #f9f9f9;" class="hidden">
                <h3><a href="#schedule" style="text-decoration: none; color: #1976d2;">최신 일정</a></h3>
                <ul id="latest-schedules" style="list-style-type: none; padding: 0;"></ul>
