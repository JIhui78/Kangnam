        <!-- 홈페이지 바로가기 섹션 -->
        <section id="homepage-linkage" class="main-content">
            <h2>홈페이지 바로가기</h2>
            <p>강남대학교 공식 홈페이지로 이동합니다.</p>
            <a href="https://www.kangnam.ac.kr/" class="button" target="_blank">강남대학교 홈페이지 바로가기</a>
        </section>

        <!-- 오늘 일정 섹션 -->
        <section id="schedule" class="main-content">
            <h2>오늘 일정</h2>
            <p>날짜와 내용을 입력하여 일정을 추가하고 관리할 수 있습니다.</p>
            <form id="schedule-input-form" class="hidden">
                <label for="schedule-date">날짜:</label><br>
                <input type="date" id="schedule-date" name="schedule-date" required><br><br>
                <label for="schedule-content">내용:</label><br>
                <input type="text" id="schedule-content" name="schedule-content" required placeholder="일정 내용을 입력하세요..."><br><br>
                <button type="submit">일정 추가</button>
            </form>
            <div id="schedule-display-area" style="margin-top: 20px; padding: 15px; border: 1px dashed #ccc; background-color: #f0f0f0; border-radius: 5px;" class="hidden">
                <h3>내 일정 목록:</h3>
                <ul id="schedule-items" style="list-style-type: none; padding: 0;"></ul>
            </div>
        </section>

        <!-- 로그인/회원가입 섹션 -->
        <section id="login" class="main-content">
            <h2>로그인 및 회원가입</h2>
            <div id="login-form-container">
                <h3>로그인</h3>
                <form id="login-form" action="#" method="POST">
                    <label for="login_student_id">학번:</label><br>
                    <input type="text" id="login_student_id" name="login_student_id" required><br><br>
                    <label for="login_password">비밀번호:</label><br>
                    <input type="password" id="login_password" name="login_password" required><br>
                    <span class="forgot-password"><a href="#">비밀번호 찾기</a></span><br>
                    <button type="submit">로그인</button>
                </form>
                <button id="show-register-form-button" class="button" style="margin-top: 10px; background-color: #4CAF50;">회원가입</button>
            </div>

            <div id="register-form-container" class="hidden">
                <h3>회원가입</h3>
                <form id="register-form" action="#" method="POST">
                    <label for="register_student_id">학번:</label><br>
                    <input type="text" id="register_student_id" name="register_student_id" required><br><br>
                    <label for="register_password">비밀번호:</label><br>
                    <input type="password" id="register_password" name="register_password" required><br><br>
                    <label for="register_confirm_password">비밀번호 확인:</label><br>
                    <input type="password" id="register_confirm_password" name="register_confirm_password" required><br><br>
