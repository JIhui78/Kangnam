<body>
    <div id='auth-section'>
        <div class='card' style='width:400px; margin:100px auto;'>
            <h2 id='auth-title' style='text-align:center'>KNU 알리미 로그인</h2>
            <input type='text' id='user-id' placeholder='학번'>
            <input type='password' id='user-pw' placeholder='비밀번호'>
            <div id='signup-fields' class='hidden'>
                <input type='text' id='user-name' placeholder='이름'>
                <select id='user-dept-signup'></select>
            </div>
            <button class='btn btn-primary' id='main-auth-btn' onclick='handleAuth()' style='width:100%'>로그인</button>
            <p style='text-align:center; cursor:pointer; color:#666; margin-top:15px' onclick='toggleAuthMode()' id='auth-toggle-text'>회원가입이 필요하신가요?</p>
        </div>
    </div>

    <div id='main-app' class='hidden'>
        <header>
            <div style='display:flex; align-items:center; gap:20px'>
                <span style='font-size:20px; font-weight:800'>KNU 알리미</span>
                <nav class='top-nav'>
                    <div class='top-nav-item' id='nav-home' onclick='showPage("home")'>홈</div>
                    <div class='top-nav-item' id='nav-study' onclick='showPage("study")'>학습관리</div>
                    <div class='top-nav-item' id='nav-schedule' onclick='showPage("schedule")'>일정관리</div>
                    <div class='top-nav-item' id='nav-community' onclick='showPage("community")'>커뮤니티</div>
                </nav>
            </div>
            <button class='btn btn-accent' onclick='logout()'>로그아웃</button>
        </header>

        <div class='container'>
            <section id='page-home'>
                <div style='display:grid; grid-template-columns: 350px 1fr; gap:25px'>
                    <div class='card'>
                        <div style='text-align:center'>
                            <img src='' id='display-profile-img' class='profile-img'>
                            <h3 id='display-name' style='margin:10px 0 5px 0'></h3>
                            <p id='display-dept' style='color:var(--primary); font-weight:bold; margin:0'></p>
                            <p id='display-msg' style='color:#666; font-size:14px; margin-bottom:15px'></p>
                            <button class='btn btn-primary' onclick='openProfileModal()' style='width:100%'>프로필 수정</button>
                        </div>
                        <div class='summary-box'>
                            <div class='summary-item'><span class='summary-lab'>오늘 공부</span><span class='summary-val' id='home-today-time'>0m</span></div>
                            <div class='summary-item'><span class='summary-lab'>전체 랭킹</span><span class='summary-val' id='home-total-rank'>-</span></div>
                            <div class='summary-item'><span class='summary-lab'>학과 랭킹</span><span class='summary-val' id='home-dept-rank'>-</span></div>
                        </div>
                    </div>
                    <div>
                        <div class='card'>
                            <h3>🚀 바로가기</h3>
                            <div style='display:flex; gap:10px'>
                                <a href='https://www.kangnam.ac.kr' target='_blank' style='flex:1; background:#eee; padding:15px; border-radius:12px; text-align:center; text-decoration:none; color:var(--primary); font-weight:700'>학교 홈</a>
                                <a href='https://sugang.kangnam.ac.kr' target='_blank' style='flex:1; background:#eee; padding:15px; border-radius:12px; text-align:center; text-decoration:none; color:var(--primary); font-weight:700'>수강신청</a>
                                <a href='#' id='dept-link' target='_blank' style='flex:1; background:#eee; padding:15px; border-radius:12px; text-align:center; text-decoration:none; color:var(--primary); font-weight:700'>학과 홈</a>
                            </div>
                        </div>
                        <div style='display:grid; grid-template-columns: 1fr 1fr; gap:20px'>
                            <div class='card'>
                                <h3>📅 주요 일정 (D-Day)</h3>
                                <div id='home-upcoming-list'></div>
                            </div>
                            <div class='card'>
                                <h3>📣 최신 커뮤니티 글</h3>
                                <div id='home-community-preview' style='margin-top:10px'></div>
                                <button class='btn btn-primary' onclick='showPage("community")' style='width:100%; margin-top:10px; font-size:12px;'>전체보기</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section id='page-community' class='hidden'>
                <div class='card'>
                    <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:20px'>
                        <h2>🏫 KNU 광장</h2>
                        <div style='display:flex; gap:10px'>
                             <input type='text' id='search-input' placeholder='키워드 검색...' style='margin:0; width:200px' onkeyup='if(window.event.keyCode==13){renderCommunity()}'>
                             <button class='btn btn-primary' onclick='openPostModal()'>글쓰기</button>
                        </div>
                    </div>
                    <div style='display:flex; gap:10px; margin-bottom:20px; overflow-x:auto; padding-bottom:5px'>
                        <button class='btn' onclick='filterCommunity("all")' id='btn-cat-all'>전체</button>
                        <button class='btn' onclick='filterCommunity("자유")'>자유</button>
                        <button class='btn' onclick='filterCommunity("공부")'>공부</button>
                        <button class='btn' onclick='filterCommunity("장터")'>장터</button>
                        <button class='btn' onclick='filterCommunity("홍보")'>홍보</button>
                        <button class='btn' onclick='filterCommunity("동아리")'>동아리</button>
                    </div>
                    <div id='community-post-list'></div>
                </div>
            </section>

            <section id='page-study' class='hidden'>
                <div style='display:grid; grid-template-columns: 1fr 380px; gap:25px'>
                    <div>
                        <div class='card' style='text-align:center'>
                            <h1 id='timer-display' style='font-size:48px'>00:00:00</h1>
                            <button class='btn btn-primary' id='timer-btn' onclick='toggleTimer()'>학습 시작</button>
                        </div>
                        <div class='card'>
                            <div style='display:flex; justify-content:space-between; align-items:center'>
                                <h3>📊 주간 학습 통계 (월-일)</h3>
                                <div>
                                    <button class='arrow-btn' onclick='changeWeek(-1)'>◀</button>
                                    <button class='arrow-btn' onclick='changeWeek(1)'>▶</button>
                                </div>
                            </div>
                            <div style='height:180px; margin-top:10px'><canvas id='stats-chart'></canvas></div>
                        </div>
                        <div class='card'>
                            <div style='display:flex; justify-content:space-between; align-items:center'>
                                <h3>📅 <span id='mini-cal-month-label'></span> 학습 캘린더</h3>
                                <div>
                                    <button class='arrow-btn' onclick='changeMonth(-1)'>◀</button>
                                    <button class='arrow-btn' onclick='changeMonth(1)'>▶</button>
                                </div>
                            </div>
                            <div class='calendar-grid' id='study-mini-calendar'></div>
                        </div>
                    </div>
                    <div class='card'>
                        <div style='display:flex; justify-content:space-between; align-items:center'>
                            <h3>🏆 실시간 랭킹</h3>
                            <select id='rank-filter' onchange='renderRanking()' style='width:auto; margin:0;'>
                                <option value='all'>전체</option>
                                <option value='dept'>내 학과</option>
                            </select>
                        </div>
                        <div id='ranking-list'></div>
                    </div>
                </div>
            </section>

            <section id='page-schedule' class='hidden'>
                <div class='card'>
                    <h3>🗓 일정 등록</h3>
                    <div style='display:flex; gap:10px; margin-bottom:15px'>
                        <input type='date' id='event-date'>
                        <select id='event-cat' style='font-weight:bold;'></select>
                        <input type='text' id='event-title' placeholder='할 일 입력'>
                        <button class='btn btn-primary' onclick='addEvent()'>등록</button>
                    </div>
                    <div style='background:#f9f9f9; padding:15px; border-radius:12px; margin-bottom:20px'>
                        <h4 style='margin-top:0'>🏷 카테고리 관리</h4>
                        <div style='display:flex; gap:10px; margin-bottom:10px'>
                            <input type='text' id='new-cat-name' placeholder='새 카테고리명' style='margin:0'>
                            <input type='color' id='new-cat-color' value='#003a78' style='width:60px; padding:2px; margin:0; height:40px;'>
                            <button class='btn btn-primary' onclick='addCat()'>추가</button>
                        </div>
                        <div id='cat-list-display'></div>
                        <p style='font-size:11px; color:#888; margin:5px 0 0 0'>* 카테고리를 <b>더블 클릭</b>하면 삭제됩니다.</p>
                    </div>
                    <p style='font-size:12px; color:#888;'>* 일정은 <b>더블 클릭</b> 시 삭제됩니다.</p>
                    <div class='calendar-grid' id='calendar-body'></div>
                </div>
            </section>
        </div>
    </div>

    <!-- 커뮤니티 글쓰기 모달 -->
    <div id='post-modal' class='modal hidden'>
        <div class='modal-content'>
            <h3 style='margin-top:0'>새 글 작성</h3>
            <select id='post-cat'>
                <option value='자유'>자유게시판</option>
                <option value='공부'>공부게시판</option>
                <option value='장터'>장터게시판</option>
                <option value='홍보'>홍보게시판</option>
                <option value='동아리'>동아리게시판</option>
            </select>
            <input type='text' id='post-title' placeholder='제목 (최대 20자)'>
            <textarea id='post-content' placeholder='내용을 입력하세요' style='height:150px; resize:none;'></textarea>
            <label class='anon-wrap'><input type='checkbox' id='post-anon'> 익명으로 작성</label>
            <div style='display:flex; gap:10px'>
                <button class='btn btn-primary' onclick='savePost()' style='flex:1'>등록</button>
                <button class='btn' onclick='closePostModal()' style='flex:1; background:#eee'>취소</button>
            </div>
        </div>
    </div>

    <!-- 게시글 상세보기 모달 -->
    <div id='post-view-modal' class='modal hidden'>
        <div class='modal-content'>
            <div id='post-detail-content'></div>
            <hr>
            <h4>댓글</h4>
            <div id='comment-list'></div>
            <div style='margin-top:10px'>
                <label class='anon-wrap'><input type='checkbox' id='comment-anon'> 익명으로 작성</label>
                <div style='display:flex; gap:5px'>
                    <input type='text' id='comment-input' placeholder='댓글을 입력하세요' style='margin:0'>
                    <button class='btn btn-primary' onclick='saveComment()'>등록</button>
                </div>
            </div>
            <button class='btn' onclick='closePostViewModal()' style='width:100%; margin-top:15px; background:#eee'>닫기</button>
        </div>
    </div>

    <div id='rank-modal' class='modal hidden'>
        <div class='modal-content' style='text-align:center'>
            <img id='rank-p-img' class='profile-img' style='margin-bottom:15px'>
            <h3 id='rank-p-name' style='margin:0'></h3>
            <p id='rank-p-dept' style='color:var(--primary); font-weight:700; margin:5px 0'></p>
            <p id='rank-p-msg' style='color:#666; font-size:14px; margin-bottom:20px'></p>
            <button class='btn btn-primary' onclick='closeRankModal()' style='width:100%'>닫기</button>
        </div>
    </div>

    <div id='profile-modal' class='modal hidden'>
        <div class='modal-content'>
            <h3 style='margin-top:0'>프로필 수정</h3>
            <label>학과:</label><select id='edit-dept'></select>
            <label>한마디:</label><input type='text' id='edit-msg'>
            <label>사진 변경:</label><input type='file' accept='image/*' onchange='previewImage(this)'>
            <div style='display:flex; gap:10px; margin-top:20px'>
                <button class='btn btn-primary' onclick='saveProfile()' style='flex:1'>저장</button>
                <button class='btn' onclick='closeProfileModal()' style='flex:1; background:#eee'>취소</button>
            </div>
        </div>
    </div>
