                </form>
                <button id="show-login-form-button" class="button" style="margin-top: 10px; background-color: #2196f3;">로그인</button>
            </div>

            <div id="logout-message-container" class="hidden">
                <p><span id="logged-in-user-display"></span>님, 환영합니다!</p>
                <button id="logout-button" class="button">로그아웃</button>
