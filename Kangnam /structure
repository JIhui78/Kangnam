                    <option value="aifusion">인공지능융합공학부</option>
                    <option value="jayu">자유전공학부</option>
                    <option value="jeonja">전자반도체공학부</option>
                    <option value="jungguk">중국콘텐츠비즈니스학과</option>
                    <option value="jungdeung">중등특수교육과</option>
                    <option value="cheyuk">체육학과</option>
                    <option value="chodeung">초등특수교육과</option>
                    <option value="computer">컴퓨터공학부</option>
                    <option value="hangugeo">한국어문학과</option>
                </select><br>
                <button type="submit" class="button" style="margin-top: 10px;">학과 선택 저장</button>
            </form>
            <div style="margin-top: 20px; padding: 15px; border: 1px dashed #ccc; background-color: #f0f0f0; border-radius: 5px;">
