            <p>이 템플릿을 필요에 맞게 자유롭게 사용자 지정하세요!</p>

            <!-- New: User Profile Section on Home page -->
            <div id="user-profile-section" style="margin-top: 30px; padding: 15px; border: 1px solid #e0e0e0; border-radius: 5px; background-color: #f9f9f9;" class="hidden"> <!-- Initially hidden -->
                <h3>내 프로필</h3>
                <div style="display: flex; align-items: center; margin-bottom: 15px;">
                    <img id="profile-picture" src="https://via.placeholder.com/100" alt="프로필 사진" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; margin-right: 20px;">
                    <div>
                        <p><strong>이름:</strong> <span id="profile-name-display">미정</span></p>
                        <p><strong>학번:</strong> <span id="profile-student-id-display">미정</span></p>
                        <p><strong>학과:</strong> <span id="profile-department-display">미정</span></p>
                    </div>
                </div>
                <button id="edit-profile-button" class="button" style="margin-top: 0;">프로필 수정</button>
                <div id="profile-edit-form" style="display: none; margin-top: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 5px; background-color: #fff;">
                    <h4>프로필 수정</h4>
                    <label for="edit-name">이름:</label><br>
                    <input type="text" id="edit-name" placeholder="이름을 입력하세요"><br>
                    <label for="edit-student-id">학번:</label><br>
                    <input type="text" id="edit-student-id" placeholder="학번을 입력하세요"><br>
                    <label for="edit-department">학과:</label><br>
                    <input type="text" id="edit-department" placeholder="학과를 입력하세요"><br>
                    <label for="edit-photo-upload">프로필 사진:</label><br>
                    <input type="file" id="edit-photo-upload" accept="image/*"><br>
                    <button id="save-profile-button" class="button" style="margin-top: 10px;">저장</button>
                    <button id="cancel-profile-button" class="button" style="margin-top: 10px; background-color: #9e9e9e;">취소</button>
                </div>
            </div>

            <!-- New: Latest Announcements snippet on Home page -->
            <div id="home-announcements-snippet" style="margin-top: 30px; padding: 15px; border: 1px solid #e0e0e0; border-radius: 5px; background-color: #f9f9f9;" class="hidden">
                <h3><a href="https://web.kangnam.ac.kr/menu/f19069e6134f8f8aa7f689a4a675e66f.do?searchMenuSeq=0" style="text-decoration: none; color: #2196f3;" target="_blank">최신 공지사항</a></h3>
