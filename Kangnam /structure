            <form id="department-selection-form">
                <label for="department-select">학과 선택:</label><br>
                <select id="department-select" name="department-select" style="width: calc(100% - 22px); padding: 10px; margin-bottom: 10px; border: 1px solid #ddd; border-radius: 4px;">
                    <option value="">학과를 선택해주세요</option>
                    <option value="gyoyuk">교육학과</option>
